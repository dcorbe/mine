tools/btrieve-oracle/crtprobe.exe

# Tele-Arena 5.6d source, extracted from Ta56dSrc.ZIP in archive/ for reference
# (9,104 lines across TSGARN-2..5.C). Third-party source read as an oracle for
# how a REAL module calls the host API -- prfmlt takes a message number, pmlt
# takes a format string, and so on -- which headers alone do not settle. Not
# ours to commit; the zip it came from is already in archive/.
re/tasrc/

# `unzip -j archive/galacticomm/mbbs511s.zip 'BTVSTF.*' 'ECBTVSTF.C' -d re/btvsrc`
# MajorBBS 5.11's Btrieve wrapper layer. Note it does NOT contain the twelve
# wrappers Track B adds -- see that plan's Task 1. The oracle for those is
# PLBTVSTF.C, which lives in archive/ and needs no extraction.
re/btvsrc/

