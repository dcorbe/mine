# Claude workspace (per user prefs: never check in)
.claude/
CLAUDE.md

# Mirrored third-party documentation sites (large raw HTML dumps)
docs/mirrors/

# Original game binaries and archives — never commit
*.rar
*.DLL
*.dll
mudbins/
tmp/

# Period MAJORBBS.EXE host binaries, extracted from archive/ for disassembly.
# The 16-bit host is an NE *executable* that exports the API modules import --
# there is no MAJORBBS.DLL -- so this is the primary source for every routine
# whose C never survived. Re-extractable; see docs/MIRRORS.md.
re/hosts/

# Reverse-engineering derived artifacts (regenerable / derivative of the binary)
re/ghidra_proj/
re/wg_nt_ghidra/
re/wccmmpls_ghidra/
re/wg_nt_ref/
# Worldgroup 3.3 host source, 4,868 files / 73 MB. Re-extract with
# `unzip archive/galacticomm/source33.zip -d re/wg33src` -- a plain zip, unlike
# the activation-encrypted developer kits in archive/galacticomm/wg32sdk.zip.
re/wg33src/
# Pervasive Btrieve 6.15 engine: staged binaries, Ghidra project and the 1.6 MB
# of decompiled C. Regenerable -- re-run tools/btrieve-oracle/ and the
# analyzeHeadless invocation recorded in docs/plans/2026-08-08-btrieve-real-oracle.md.
re/btrieve_ghidra/
re/exports/*
!re/exports/gang_house_description_files.txt
re/__pycache__/
re/mmud_wgnt.sqlite

# Third-party reference repositories (vendored, not ours)
re/Nightmare-Redux/
re/MMUD-Explorer/

# Recovered Galacticomm archive: vendor SDKs, host binaries, scanned manuals,
# and cloned third-party module/tooling repos. Hundreds of MB, all of it
# re-downloadable from software.bbsdocumentary.com and GitHub, and none of it
# ours to redistribute. Derived tables extracted from it (ordinal maps) are
# committed separately under re/.
archive/

# Stray live-board captures dropped in the working directory: their TX
# stream carries the account password, so they must never be committed.
# Root-scoped on purpose — the curated RX-only corpus in re/oracle/ is
# added by hand and stays tracked.
/*.raw
/*_timing.log

